# Local backend
PORT=5000
NODE_ENV=development

# Local Docker MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your-local-db-password
DB_NAME=osta_elearning_platform
DB_PORT=3306

# Authentication
# IMPORTANT: set this in your local backend/.env; never commit the real secret.
JWT_SECRET=your-local-jwt-secret
JWT_EXPIRES_IN=7d

# Optional instructor payment defaults
# TELEBIRR_ACCOUNT=your-telebirr-account
# CBE_ACCOUNT=your-cbe-account
# PAYMENT_ACCOUNT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OSTA AI Tutor
# Keep the AI key on the backend only. Never use VITE_* for this key.
# AI_API_KEY=your-provider-api-key
# AI_API_URL=https://api.openai.com/v1/responses
# AI_MODEL=your-supported-model
