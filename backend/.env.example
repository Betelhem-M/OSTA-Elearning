# Local backend
PORT=5000
NODE_ENV=development

# Local Docker MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your-local-db-password
DB_NAME=osta_elearning_platform
DB_PORT=3306

# Authentication
# IMPORTANT: set this in your local backend/.env; never commit the real secret.
JWT_SECRET=your-local-jwt-secret
JWT_EXPIRES_IN=7d

# Frontend URL used after OAuth login
FRONTEND_URL=http://localhost:5173
# Production: https://osta-elearning-platform.vercel.app

# Backend public URL used for OAuth callbacks
BACKEND_URL=http://localhost:5000
# Production: https://osta-elearning-backend-production.up.railway.app

# Google OAuth
# Create a Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
# Create an OAuth App in GitHub Developer Settings.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# Optional instructor payment defaults
# TELEBIRR_ACCOUNT=your-telebirr-account
# CBE_ACCOUNT=your-cbe-account
# PAYMENT_ACCOUNT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OSTA AI Tutor
# Keep the AI key on the backend only. Never use VITE_* for this key.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_URL=https://api.openai.com/v1/responses
# OPENAI_MODEL=gpt-5
