# PORT=5000

# Local database (DATABASE_URL is preferred on Railway)
# DATABASE_URL=mysql://root:password@localhost:3306/osta_elearning
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=osta_elearning
# DB_PORT=3306

# Authentication
# JWT_SECRET=replace-with-a-long-random-secret

# Instructor payment account defaults (optional)
# TELEBIRR_ACCOUNT=your-telebirr-account
# CBE_ACCOUNT=your-cbe-account
# PAYMENT_ACCOUNT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OSTA AI Tutor
# Keep the API key on the backend. Never put it in frontend VITE_* variables.
# AI_API_KEY=your-provider-api-key
# AI_API_URL=https://api.openai.com/v1/responses
# AI_MODEL=gpt-5.6-luna
